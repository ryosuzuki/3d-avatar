+# Task-local public-file downloader preserves LFS hashes, avoids unrelated prior weights.
+_original_task_query = AutoModelQuery.query
+def _video2mr_task_query(self, model_name, *args, **kwargs):
+    from pathlib import Path
+    root = Path(__file__).resolve().parents[2] / "pretrained_models"
+    if model_name == "LHMPP-700M" and (root / "video2mr-models-ready.json").exists():
+        return str(root / "lhmpp-700m")
+    return _original_task_query(self, model_name, *args, **kwargs)
+AutoModelQuery.query = _video2mr_task_query
